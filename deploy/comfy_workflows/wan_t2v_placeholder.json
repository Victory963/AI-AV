{
  "_longfilm": {
    "name": "wan_t2v_placeholder",
    "mode": "t2v",
    "comment": "占位 T2V 模板：结构对、模型名是假的。上线前按 README.md 替换 PLACEHOLDER_*，并按本机 ComfyUI 的 /object_info 校对 class_type。",
    "bind": {
      "positive": "4.inputs.text",
      "negative": "5.inputs.text",
      "seed": "7.inputs.seed",
      "width": "6.inputs.width",
      "height": "6.inputs.height",
      "length": "6.inputs.length",
      "fps": "9.inputs.frame_rate",
      "filename_prefix": "9.inputs.filename_prefix"
    },
    "lora_node": "3",
    "optional_bind": []
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "扩散模型"},
    "inputs": {"unet_name": "PLACEHOLDER_wan_t2v_14b.safetensors", "weight_dtype": "fp8_e4m3fn"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "文本编码器"},
    "inputs": {"clip_name": "PLACEHOLDER_umt5_xxl.safetensors", "type": "wan", "device": "default"}
  },
  "3": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "风格 LoRA（无 LoRA 时由 provider 自动旁路）"},
    "inputs": {
      "lora_name": "PLACEHOLDER_style.safetensors",
      "strength_model": 0.8,
      "model": ["1", 0]
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "正向提示词"},
    "inputs": {"text": "", "clip": ["2", 0]}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "负向提示词"},
    "inputs": {"text": "", "clip": ["2", 0]}
  },
  "6": {
    "class_type": "EmptyHunyuanLatentVideo",
    "_meta": {"title": "空视频隐空间"},
    "inputs": {"width": 1280, "height": 720, "length": 81, "batch_size": 1}
  },
  "7": {
    "class_type": "KSampler",
    "_meta": {"title": "采样"},
    "inputs": {
      "seed": 0,
      "steps": 30,
      "cfg": 6.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": {"title": "解码"},
    "inputs": {"samples": ["7", 0], "vae": ["10", 0]}
  },
  "9": {
    "class_type": "VHS_VideoCombine",
    "_meta": {"title": "合成视频"},
    "inputs": {
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "longfilm/t2v",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 16,
      "save_metadata": true,
      "pingpong": false,
      "save_output": true,
      "images": ["8", 0]
    }
  },
  "10": {
    "class_type": "VAELoader",
    "_meta": {"title": "VAE"},
    "inputs": {"vae_name": "PLACEHOLDER_wan_vae.safetensors"}
  }
}
