{
  "_comment": [
    "Wan 2.2 TI2V-5B 的 ComfyUI API 格式工作流（文生视频 / 图生视频共用）。",
    "节点签名取自实跑的 ComfyUI 0.30.0 的 /object_info，不是照文档猜的。",
    "给 start_image 就是 I2V，不给就是 T2V —— Wan22ImageToVideoLatent 的 start_image 是可选输入。",
    "length 必须是 4k+1：Wan 的 latent 时间维是 4 的倍数，不满会掉尾帧。",
    "shift=8.0 是 Wan 2.2 官方示例给 720p 的值；5B 模型 cfg 取 5.0 左右。"
  ],
  "1": {
    "class_type": "UNETLoader",
    "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "wan2.2_vae.safetensors"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "PLACEHOLDER_POSITIVE", "clip": ["2", 0]}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "PLACEHOLDER_NEGATIVE", "clip": ["2", 0]}
  },
  "6": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {"vae": ["3", 0], "width": 1280, "height": 704, "length": 81, "batch_size": 1}
  },
  "7": {
    "class_type": "ModelSamplingSD3",
    "inputs": {"model": ["1", 0], "shift": 8.0}
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["7", 0], "seed": 0, "steps": 30, "cfg": 5.0,
      "sampler_name": "uni_pc", "scheduler": "simple",
      "positive": ["4", 0], "negative": ["5", 0],
      "latent_image": ["6", 0], "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["8", 0], "vae": ["3", 0]}
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {"images": ["9", 0], "fps": 24.0}
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {"video": ["10", 0], "filename_prefix": "longfilm/shot", "format": "auto", "codec": "auto"}
  },
  "_bindings": {
    "_comment": "语义名 → 节点路径。comfy_local.WorkflowTemplate 按这张表注入，换工作流不用改代码。",
    "positive_prompt": "4.inputs.text",
    "negative_prompt": "5.inputs.text",
    "width": "6.inputs.width",
    "height": "6.inputs.height",
    "length": "6.inputs.length",
    "seed": "8.inputs.seed",
    "steps": "8.inputs.steps",
    "cfg": "8.inputs.cfg",
    "sampler": "8.inputs.sampler_name",
    "shift": "7.inputs.shift",
    "fps": "10.inputs.fps",
    "filename_prefix": "11.inputs.filename_prefix",
    "unet": "1.inputs.unet_name",
    "clip": "2.inputs.clip_name",
    "vae": "3.inputs.vae_name"
  }
}
