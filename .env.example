# Copy this to .env and fill in only what you need. Every key is read from environment variables and never written into code or logs
# (outgoing logs are masked by providers/_http.py:redact). Without any key, the mock engine runs the full pipeline offline.

PYTHONPATH=src

# ---- Official closed-source channel
ARK_API_KEY=                 # Volcengine Ark Seedance
ARK_BASE_URL=                # optional, overrides the default endpoint
DASHSCOPE_API_KEY=           # Alibaba Bailian Wanxiang (also used for official LoRA training)
DASHSCOPE_BASE_URL=          # optional

# ---- Self-hosted open-source channel
COMFY_URL=                   # e.g. http://<pod-ip>:8188, the ComfyUI started by deploy/bootstrap_gpu.sh

# ---- Aggregator platforms (third fallback in the failover chain)
FAL_KEY=
REPLICATE_API_TOKEN=

# ---- Training / cloud
HF_TOKEN=                    # needed to download base-model weights (train_lora_pod.sh)
AWS_REGION=us-east-1         # S3 return of serverless handler output

# ---- Local tools (auto-detected when unset)
LONGFILM_FFMPEG=             # default lookup order: bin/ffmpeg → PATH → imageio-ffmpeg
LONGFILM_FFPROBE=
LONGFILM_FONT=               # CJK font; see assets/fonts/README.md
LONGFILM_OUT=out
LONGFILM_JOB_TIMEOUT=900
RIFE_DIR=                    # Practical-RIFE directory (GPU frame interpolation)
